{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRIVO External Project Integration",
  "type": "object",
  "properties": {
    "schema_version": { "const": "crivo.project-integration/1.0.0" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "source_dir": { "type": "string", "minLength": 1 },
    "adapter": { "const": "ctest" },
    "governance_mode": { "const": "shadow" },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "configure_args": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "international_profile": { "type": "string" }
  },
  "required": ["schema_version", "project_id", "source_dir", "adapter", "governance_mode", "timeout_seconds", "configure_args", "capabilities"],
  "additionalProperties": false
}
