{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRIVO Runtime Target Admission",
  "type": "object",
  "properties": {
    "schema_version": { "const": "crivo.target-admission/1.0.0" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "source_dir": { "type": "string", "minLength": 1 },
    "build": {
      "type": "object",
      "properties": { "configure_args": { "type": "array", "items": { "type": "string" } } },
      "required": ["configure_args"], "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "properties": {
        "initialize": { "$ref": "#/$defs/argv" },
        "seed": { "$ref": "#/$defs/argv" },
        "validate": { "$ref": "#/$defs/argv" },
        "serve": { "$ref": "#/$defs/argv" }
      },
      "required": ["initialize", "seed", "validate", "serve"], "additionalProperties": false
    },
    "http": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1024, "maximum": 65535 } },
      "required": ["port"], "additionalProperties": false
    },
    "capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
  "required": ["schema_version", "project_id", "source_dir", "build", "operations", "http", "capabilities"],
  "additionalProperties": false
}
