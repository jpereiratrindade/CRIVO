{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crivo.sister.org/schemas/analysis/1.0.0.schema.json",
  "title": "CRIVO captured analysis observations",
  "type": "object",
  "required": ["schema_version", "http_observations"],
  "properties": {
    "schema_version": {"const": "crivo.analysis/1.0.0"},
    "http_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "status"],
        "properties": {
          "method": {"type": "string"},
          "status": {"type": "integer", "minimum": 100, "maximum": 599},
          "case": {"type": "string"},
          "latency_ms": {"type": "number", "minimum": 0},
          "headers": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
