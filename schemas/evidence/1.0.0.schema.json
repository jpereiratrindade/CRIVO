{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRIVO Evidence Package Schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "crivo.evidence/1.0.0"
    },
    "evidence_id": { "type": "string" },
    "project_id": { "type": "string" },
    "executor": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["adapter", "version"],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "start_utc": { "type": "string" },
        "end_utc": { "type": "string" },
        "duration_seconds": { "type": "number" }
      },
      "required": ["start_utc", "end_utc", "duration_seconds"],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" }
      },
      "required": ["total", "passed", "failed", "skipped"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "format": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "required": ["path", "format", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "project_id",
    "executor",
    "timing",
    "summary",
    "artifacts"
  ],
  "additionalProperties": false
}
