{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRIVO Profile Registry Schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "crivo.profile/1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "selection": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_specs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_specs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "fail_fast": {
          "type": "boolean"
        },
        "allow_unqualified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "selection"
  ],
  "additionalProperties": false
}
